{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "cd ../.. && npm install",
  "buildCommand": "cd ../.. && npm run build:rules && npm run build:shared && npm run build -w @dlbh/web",
  "headers": [
    {
      "source": "/extension/(.*)\\.zip",
      "headers": [
        {
          "key": "Content-Disposition",
          "value": "attachment; filename=\"dhanlaxmi-business-hub-extension.zip\""
        },
        {
          "key": "Content-Type",
          "value": "application/zip"
        }
      ]
    }
  ]
}
